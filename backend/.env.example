# Orion backend environment configuration
# Copy to .env and fill in real values. Never commit .env.

# AssemblyAI holds the live call and verifies it afterwards. One key covers
# the Voice Agent API, streaming transcription, pre-recorded transcription and
# LLM Gateway - create one at assemblyai.com/dashboard/api-keys.
ASSEMBLYAI_API_KEY=

# Which backend holds the call (see app/services/live_bridge.py):
#   agent_api  - AssemblyAI Voice Agent API, one websocket for the whole agent
#   stt_gemini - AssemblyAI streaming STT + LLM Gateway (Gemini) + Google TTS
VOICE_BACKEND=agent_api

# Voice Agent API voice id. Fetch the live catalog before changing this -
# GET https://agents.assemblyai.com/v1/voices with "Authorization: Bearer <key>".
# An id that isn't in that list is rejected outright at session.update.
ASSEMBLYAI_VOICE=anna

# LLM Gateway model id - exact versioned strings only, a bare family name is
# invalid. Used for the structured jobs: post-call outcome extraction and live
# turn classification.
#
# Access is granted PER ACCOUNT, not just per id: a current, correctly-spelled
# model still returns 400 "Your account does not have access to this LLM Gateway
# model" if the account isn't entitled to it. Without billing, the only reachable
# model is AssemblyAI's own qwen3.5-4b-32k-fast - which also does not support
# tool calling. Add billing to the AssemblyAI account to unlock
# gemini-3.6-flash and the Claude models.
LLM_GATEWAY_MODEL=qwen3.5-4b-32k-fast

# Which model holds the negotiation itself on the stt_gemini backend:
#   gemini_direct - google-genai with GEMINI_API_KEY (the default; a 4B model
#                   without tool calling can't run a multi-round negotiation)
#   llm_gateway   - AssemblyAI LLM Gateway, using LLM_GATEWAY_MODEL above.
#                   Switch once the account can reach a capable model; nothing
#                   else needs to change.
NEGOTIATION_LLM=gemini_direct


# Still used for bill extraction from an uploaded photo/PDF (multimodal, which
# LLM Gateway's text-only chat completions can't do). No longer on the call path.
# Extraction model chain, tried in order. Not a single pin: a Gemini model can
# answer "currently experiencing high demand" for minutes at a time, and
# retrying the same one is futile - that is how bill extraction kept failing.
GEMINI_MODELS=gemini-3.5-flash,gemini-flash-lite-latest,gemini-3.1-flash-lite-preview

GEMINI_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Optional. The per-negotiation success fee. Stripe does not serve Nigerian
# merchants, so on such a deployment this stays unset and the charge button is
# hidden rather than offered and failing.
STRIPE_SECRET_KEY=

# Paystack takes the subscription payment. Stripe cannot be used by a Nigerian
# business at all; Paystack is Stripe-owned and covers NG/GH/KE/ZA/CI.
#
# The secret key is from Settings > API Keys & Webhooks. Set the dashboard's
# webhook URL to <BASE_URL>/api/plan/webhook - that webhook is the only thing
# that grants a paid plan.
PAYSTACK_SECRET_KEY=

# Whole units of the currency below. NGN because a Nigerian Paystack account
# settles in naira; about $15.
PAYSTACK_CURRENCY=NGN
PRO_PRICE=22500

# Which methods the checkout offers, in order. Card is listed first even
# though a new account usually cannot take cards yet: Paystack ignores a
# channel the account lacks, so card appears automatically once enabled.
# A list with nothing active in it is what fails.
PAYSTACK_CHANNELS=card,bank,ussd,bank_transfer

# Pin a specific monthly plan. Left blank, one matching the price and interval
# is found or created on the first upgrade.
PAYSTACK_PLAN_CODE=

# Where the SQLite fallback lives when Supabase is unconfigured. On a container
# platform this needs to be a mounted volume or the data dies with the disk.
DATABASE_PATH=orion.db

# The Gemini Live model, used only by the stt_gemini voice backend.
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# The stt_gemini backend synthesises Orion's voice with Google Cloud TTS
# (AssemblyAI has no standalone TTS product). Standard Google credentials -
# a service account key path, or ambient credentials on the host.
GOOGLE_APPLICATION_CREDENTIALS=
BASE_URL=http://localhost:8080

# Comma-separated list of origins allowed to call this API from a browser
# (CORS). Defaults to the frontend's local dev origin if unset - set this to
# your deployed frontend's real URL(s) in production, e.g.
# ALLOWED_ORIGINS=https://orion.example.com
ALLOWED_ORIGINS=http://localhost:3000

# Gates POST /api/negotiations/start and /charge (see app/security.py) -
# required header X-Orion-Admin-Key must match this exactly. Must match the
# frontend's ADMIN_API_KEY (web/.env.example) so its server-side proxy routes
# can authenticate on your behalf.
# Encrypts the account-verification details a customer supplies (account
# number, security PIN, last-4 SSN) so they are never stored in the clear.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Unset means the vault refuses to store anything, and Orion cannot answer a
# representative's verification questions - which ends most real calls.
# Escalation - how the customer is reached when the agent hits a wall mid-call.
#
# WHO is reached is set per user on the Account page and stored on their
# profile, because Orion is multi-tenant: a single address here would be paged
# about every customer's call and told the provider and best offer from
# negotiations belonging to strangers. The two ESCALATION_*_TO values below are
# only a fallback for a single-user or local deployment, and should be left
# unset in a deployment with real users.
# All optional: an unconfigured channel is skipped rather than erroring, because
# a failed notification must never take down a live call.
#
# WhatsApp goes through Twilio (the trial includes 100 free WhatsApp messages).
# The number needs the whatsapp: prefix handled for you - just put the E.164
# number here.
TWILIO_WHATSAPP_FROM=
ESCALATION_WHATSAPP_TO=

# Email goes through SendGrid, which Twilio owns (the trial includes 3,000 free
# emails). ESCALATION_EMAIL_FROM must be a verified sender in SendGrid.
SENDGRID_API_KEY=
ESCALATION_EMAIL_TO=
ESCALATION_EMAIL_FROM=

# Used to build a link back into the app in escalation messages.
PUBLIC_APP_URL=https://orionbuild.netlify.app

# Supabase - profiles and negotiations. Without these the app falls back to a
# local SQLite file, which has no backups and no user scoping.
#
# SUPABASE_SERVICE_KEY is the SECRET key (Project Settings -> API keys ->
# service_role / secret), not the publishable one. It bypasses RLS, which is
# the point: identity comes from Dynamic, so auth.uid() is null in that
# database and both tables are deny-all by design. Never expose it to a
# browser - only the FastAPI backend should hold it.
SUPABASE_URL=https://eqcolwmplrmpezpcbske.supabase.co
SUPABASE_SERVICE_KEY=

ACCOUNT_ENCRYPTION_KEY=

# Dynamic's environment id. The backend fetches Dynamic's JWKS with this and
# verifies session tokens itself. Leave it unset and the backend falls back to
# trusting the proxy's X-Orion-User header - which makes ADMIN_API_KEY a
# universal impersonation token. Set it.
DYNAMIC_ENVIRONMENT_ID=f3e8d79d-80c3-4332-b740-39c22eef6428

ADMIN_API_KEY=
