# Orion web (Next.js) environment configuration
# Copy to .env.local and fill in real values. Never commit .env.local.

# Public - inlined into the browser bundle at build time. Must point at the real deployed backend;
# the fallback below (backend's real default port) is a dev convenience, not a production value.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Server-only - NEVER prefix with NEXT_PUBLIC_. Gates the server-side proxy routes
# (web/app/api/negotiations/start/route.ts and .../[taskId]/charge/route.ts), which forward to the
# backend's own ADMIN_API_KEY-gated endpoints. Must match the backend's ADMIN_API_KEY exactly - the
# whole point of proxying through these routes is that this key never reaches the browser bundle.
ADMIN_API_KEY=

# Server-only - if the backend is reachable at a different URL than NEXT_PUBLIC_API_URL from the
# web service's own network (e.g. Railway's private network), set this to override just the
# server-side proxy routes' upstream target. Falls back to NEXT_PUBLIC_API_URL if unset.
API_URL=

# Dynamic (dynamic.xyz) environment ID - public, ships in the browser bundle.
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=f3e8d79d-80c3-4332-b740-39c22eef6428
